import mongoose, { Document, Model, Schema } from 'mongoose';

export interface IOrder extends Document {
  patientId: string;
  name: string;
  tests: any[];
  amount: number;
  amountPaid: number;
  bal: number;
  discount: number;
  clinic: string;
  clinicId?: string;
  referral?: string;
  referralId?: string;
  billTo?: string;
  billToName?: string;
  billToRef?: string;
  user: string;
  status?: string;
  slug?: string;
  bDate?: string;
  isCancelled?: boolean;
  branch?: string;
  branchId?: mongoose.Types.ObjectId;
  revenue?: number;
  createdAt?: Date;
  updatedAt?: Date;
}

const OrderSchema: Schema<IOrder> = new mongoose.Schema({
  patientId:{type: String},
  name:{type: String},
  tests:{type: Array},
  amount: {type: Number}, 
  amountPaid: {type: Number, default:0}, 
  bal: {type: Number},  
  discount: {type: Number},  
  clinic:{type: String},
  clinicId:{type: String},       
  referral:{type: String},        
  referralId:{type: String},
  clinicId:{type: String},
  billTo:{type: String},
  billToName: { type: String },
  billToRef: { type: String },
  user:{type: String,   required: true},
  status:{type: String},
  slug:{type: String},
  bDate: {
    type: String,
  },
  isCancelled:{type:Boolean, default:false},
  branch: {type: String},
  branchId: { type: mongoose.Types.ObjectId, ref: 'Branch' },
  revenue: { type: Number, default: 0 },
}, {
  timestamps: true
});

const Order: Model<IOrder> = mongoose.models.order || mongoose.model<IPatient>('order', OrderSchema);
export default Order;

